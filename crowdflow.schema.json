{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrowdFlow layout v1",
  "description": "A 32.4 by 21.6 meter venue. Runtime validation also checks bounds, exit overlap, blocked exits, and available starting positions.",
  "type": "object",
  "required": ["version", "seed", "crowd", "layout"],
  "properties": {
    "version": { "const": 1 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "crowd": { "type": "integer", "minimum": 20, "maximum": 300 },
    "layout": {
      "type": "object",
      "required": ["name", "obstacles", "exits"],
      "properties": {
        "name": { "$ref": "#/$defs/label" },
        "obstacles": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "required": ["id", "label", "x", "y", "w", "h"],
            "properties": {
              "id": { "$ref": "#/$defs/label" },
              "label": { "$ref": "#/$defs/label" },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 31.8,
                "multipleOf": 0.6
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 21,
                "multipleOf": 0.6
              },
              "w": {
                "type": "number",
                "minimum": 0.6,
                "maximum": 32.4,
                "multipleOf": 0.6
              },
              "h": {
                "type": "number",
                "minimum": 0.6,
                "maximum": 21.6,
                "multipleOf": 0.6
              }
            }
          }
        },
        "exits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["id", "label", "side", "center", "width"],
            "properties": {
              "id": { "$ref": "#/$defs/label" },
              "label": { "$ref": "#/$defs/label" },
              "side": { "enum": ["east", "west", "north", "south"] },
              "center": { "type": "number", "minimum": 0.6, "maximum": 31.8 },
              "width": { "type": "number", "minimum": 1.2, "maximum": 6 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "\\S"
    }
  }
}
